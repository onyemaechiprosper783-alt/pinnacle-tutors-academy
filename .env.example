# Supabase — from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose to the client, never prefix
# with NEXT_PUBLIC_. Used only inside app/api/* routes for scoring, admin
# bootstrap, and leaderboard writes that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# One-time secret used to promote the very first admin account (see
# app/api/admin/bootstrap/route.ts). Set this in your host's env vars,
# rotate/remove it after you've created the first admin.
ADMIN_BOOTSTRAP_SECRET=change-this-to-a-long-random-string

NEXT_PUBLIC_SITE_URL=http://localhost:3000
